BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Sans Redis installe (souvent en local Windows): utiliser "sync" + "file".
# Avec Redis en prod: QUEUE_CONNECTION=redis et CACHE_STORE=redis (demarrer le service Redis).
QUEUE_CONNECTION=sync
IMPORT_QUEUE_NAME=imports
IMPORT_CHUNK_SIZE=1000
IMPORT_ENABLE_CHUNK_LOGS=true
IMPORT_SUPER_ADMIN_MATRICULES=19684

# Bootstrap seed data (premier demarrage)
BOOTSTRAP_ADMIN_MATRICULE=19684
